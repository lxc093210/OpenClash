config smartbox 'main'
	option enabled '0'
	option mode 'sidecar'
	option binary '/usr/bin/sing-box-smart'
	option listen_port '2088'
	option tun_interface 'smarttun'
	option tun_address '172.19.0.1/30'
	option tun_auto_redirect '0'
	option fakeip_enabled '0'
	option fakeip_ipv4_range '198.18.0.0/15'
	option fakeip_ipv6_range '2001:2::/48'
	option controller_port '19090'
	option api_secret ''
	option probe_url 'https://www.gstatic.com/generate_204'
	option expected_status '204'
	option prefer_asn '0'
	option tolerance '0'
	option sample_rate '0.25'
	option collect_data '1'
	option use_lightgbm '1'
	option exclude_pattern '(?i)剩余|到期|官网|traffic|expire'
	option policy_priority ''

config provider
	option name 'airport1'
	option enabled '0'
	option url ''
	option user_agent 'clash'
	option update_interval '12h'
