#!/bin/sh /etc/rc.common
START=96
STOP=14
USE_PROCD=1

start_service() {
  local enabled binary
  enabled="$(uci -q get smartbox.main.enabled || echo 0)"
  [ "$enabled" = "1" ] || return 0

  # The default sidecar binds only localhost TCP ports 2088/19090. Global mode
  # is started through smartbox-start, which performs the Mihomo handover.
  binary="$(uci -q get smartbox.main.binary || echo /usr/bin/sing-box-smart)"
  case "$binary" in
    /*) ;;
    *) logger -t smartbox "Invalid Smart core path"; return 1 ;;
  esac
  [ -x "$binary" ] || { logger -t smartbox "Smart core unavailable"; return 1; }

  /usr/libexec/smartbox-generate || {
    logger -t smartbox "Smart configuration validation failed"
    return 1
  }

  procd_open_instance
  procd_set_param command "$binary" run -c /etc/sing-box-smart/config.json
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file /etc/sing-box-smart/config.json
  procd_close_instance

  if [ "$(uci -q get smartbox.main.mode || echo sidecar)" = "global" ]; then
    procd_open_instance watchdog
    procd_set_param command /usr/libexec/smartbox-watchdog
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
  fi
}

stop_service() {
  if [ "$(uci -q get smartbox.main.mode || echo sidecar)" = "global" ] &&
     [ -f /etc/sing-box-smart/handover.active ]; then
    procd_kill "smartbox" "smartbox" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      procd_running "smartbox" >/dev/null 2>&1 || break
      sleep 1
    done
    rm -f /etc/sing-box-smart/handover.active
    if [ "$(uci -q get openclash.config.enable || echo 0)" = "1" ]; then
      /etc/init.d/openclash start >/dev/null 2>&1 ||
        logger -t smartbox "Mihomo restore after SmartBox stop failed"
    fi
  fi
}
