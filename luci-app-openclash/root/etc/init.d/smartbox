#!/bin/sh /etc/rc.common
START=96
STOP=14
USE_PROCD=1

start_service() {
  local enabled binary
  enabled="$(uci -q get smartbox.main.enabled || echo 0)"
  [ "$enabled" = "1" ] || return 0

  # The M2 sidecar binds only localhost TCP ports 2088/19090.
  # It does not modify TUN, routes, DNS or firewall, so Mihomo may stay active.
  # Router-wide engine switching remains disabled until an atomic handover
  # and rollback mechanism has been implemented and tested.
  binary="$(uci -q get smartbox.main.binary || echo /usr/bin/sing-box-smart)"
  case "$binary" in
    /usr/bin/sing-box-smart|/usr/local/bin/sing-box-smart) ;;
    *) logger -t smartbox "Invalid Smart core path"; return 1 ;;
  esac
  [ -x "$binary" ] || { logger -t smartbox "Smart core unavailable"; return 1; }

  /usr/libexec/smartbox-generate || {
    logger -t smartbox "Smart configuration validation failed"
    return 1
  }

  procd_open_instance
  procd_set_param command "$binary" run -c /etc/sing-box-smart/config.json
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file /etc/sing-box-smart/config.json
  procd_close_instance
}
