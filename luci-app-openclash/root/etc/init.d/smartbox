#!/bin/sh /etc/rc.common
START=96
STOP=14
USE_PROCD=1

start_service() {
  local enabled binary
  enabled="$(uci -q get smartbox.main.enabled || echo 0)"
  [ "$enabled" = "1" ] || return 0

  # M0-M2 are localhost-only testing; never take over router-wide traffic.
  # Refuse start if OpenClash is configured OR currently running.
  if [ "$(uci -q get openclash.config.enable || echo 0)" = "1" ] || pidof clash >/dev/null 2>&1; then
    logger -t smartbox "Refusing startup: Mihomo/OpenClash is active; this prototype requires isolation"
    return 1
  fi

  binary="$(uci -q get smartbox.main.binary || echo /usr/bin/sing-box-smart)"
  case "$binary" in
    /*) ;;
    *) logger -t smartbox "Invalid core path"; return 1 ;;
  esac
  [ -x "$binary" ] || { logger -t smartbox "Smart binary is unavailable"; return 1; }
  /usr/libexec/smartbox-generate || { logger -t smartbox "Config validation failed"; return 1; }

  procd_open_instance
  procd_set_param command "$binary" run -c /etc/sing-box-smart/config.json
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file /etc/sing-box-smart/config.json
  procd_close_instance
}
