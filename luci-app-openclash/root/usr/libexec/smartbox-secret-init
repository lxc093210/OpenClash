#!/bin/sh
# Generate a controller token for the localhost-only SmartBox adapter.
# The token is never echoed; the UCI config becomes root-readable only.
set -eu
umask 077

command -v sha256sum >/dev/null 2>&1 || {
  echo "sha256sum is unavailable" >&2; exit 1;
}
[ -r /dev/urandom ] || { echo "OS random source unavailable" >&2; exit 1; }
[ -f /etc/config/smartbox ] || { echo "SmartBox is not installed" >&2; exit 1; }

token="$(head -c 48 /dev/urandom | sha256sum | cut -d ' ' -f 1)"
[ "${#token}" -eq 64 ] || { echo "Token creation failed" >&2; exit 1; }

uci -q set "smartbox.main.api_secret=$token"
uci -q commit smartbox
chmod 0600 /etc/config/smartbox
echo "SmartBox API secret generated and stored securely"
