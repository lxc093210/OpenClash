#!/bin/sh
# Install a pinned sing-box Smart release with SHA256 verification.
set -eu
umask 077
binary="$(uci -q get smartbox.main.binary || echo /usr/bin/sing-box-smart)"
case "$binary" in
 /usr/bin/sing-box-smart|/usr/local/bin/sing-box-smart) ;;
 *) echo "Invalid Smart core path" >&2; exit 1 ;;
esac
if pidof "${binary##*/}" >/dev/null 2>&1 || pidof sing-box-smart >/dev/null 2>&1; then
 echo "Stop SmartBox before replacing the core" >&2
 exit 1
fi
for utility in curl sha256sum tar awk; do
 command -v "$utility" >/dev/null 2>&1 || { echo "Missing tool: $utility" >&2; exit 1; }
done
VERSION="1.15.0-alpha.13-xiaobaf14g.8"
BASE="https://github.com/MiChongs/sing-box/releases/download/v$VERSION"
ARCH="$(uname -m)"
case "$ARCH" in
 x86_64)
  PLATFORM=linux-amd64
  EXPECTED=99f92c1e4ea3f58b3af9a5f2c991cbf86b0e8ef812f428a859ec0415d967573d
  ;;
 aarch64)
  PLATFORM=linux-arm64-musl
  EXPECTED=e04f6e586582155d4fef94e20629ae5aee6e674cb40335d3a4a0c2e93920adff
  ;;
 *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac
NAME="sing-box-$VERSION-$PLATFORM"
if [ -x "$binary" ] &&
   "$binary" version 2>/dev/null | grep -F "$VERSION" >/dev/null; then
 echo "Smart core $VERSION is already installed"
 exit 0
fi
TMP="$(mktemp -d /tmp/smartbox-core.XXXXXX)"
LOCK=/var/lock/smartbox-core.lock
mkdir -p /var/lock
mkdir "$LOCK" 2>/dev/null || {
 rm -rf "$TMP"
 echo "Smart core operation is already running" >&2
 exit 1
}
trap 'rm -rf "$TMP"; rm -f "$binary.new" /etc/sing-box-smart/sing-box-smart.previous.new; rmdir "$LOCK"' EXIT
echo "Downloading pinned Smart core for $PLATFORM"
curl -fLSs --retry 2 "$BASE/$NAME.tar.gz" -o "$TMP/$NAME.tar.gz"
ACTUAL="$(sha256sum "$TMP/$NAME.tar.gz" | awk '{print $1}')"
[ "$EXPECTED" = "$ACTUAL" ] || { echo "SHA256 mismatch" >&2; exit 1; }
EXE="$TMP/$NAME"
tar -xOzf "$TMP/$NAME.tar.gz" "$NAME" > "$EXE" || {
 echo "Executable missing from release archive" >&2; exit 1;
}
[ -s "$EXE" ] || { echo "Executable is empty" >&2; exit 1; }
chmod 700 "$EXE"
"$EXE" version | grep -F "$VERSION" >/dev/null || { echo "Unexpected binary version" >&2; exit 1; }
mkdir -p /usr/bin /etc/sing-box-smart
chmod 0700 /etc/sing-box-smart
if [ -f "$binary" ]; then
 cp -p "$binary" /etc/sing-box-smart/sing-box-smart.previous.new
 mv /etc/sing-box-smart/sing-box-smart.previous.new /etc/sing-box-smart/sing-box-smart.previous
fi
mkdir -p "${binary%/*}"
cp "$EXE" "$binary.new"
chmod 755 "$binary.new"
mv "$binary.new" "$binary"
echo "Installed sing-box Smart $VERSION"
