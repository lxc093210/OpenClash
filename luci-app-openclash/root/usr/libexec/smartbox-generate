#!/bin/sh
# Generate an isolated Smart JSON config from UCI; validate before activation.
set -eu
umask 077
mkdir -p /etc/sing-box-smart
chmod 0700 /etc/sing-box-smart
CANDIDATE="$(mktemp /etc/sing-box-smart/config.XXXXXX)"
export CANDIDATE
trap 'rm -f "$CANDIDATE"' EXIT HUP INT TERM
lua - <<'LUA'
local uci = require("luci.model.uci").cursor()
local json = require("luci.jsonc")
local cfg = uci:get_all("smartbox", "main") or {}
local function port(value, fallback)
  local n = tonumber(value or fallback)
  assert(n and n == math.floor(n) and n >= 1 and n <= 65535, "invalid port")
  return n
end
local function bounded_text(value, fallback, max, pattern)
  value = value or fallback
  assert(#value <= max and not value:find("[%c]"), "invalid Smart setting")
  if pattern then assert(value:match(pattern), "invalid Smart setting") end
  return value
end
local function flag(value, fallback)
  value = value or fallback
  assert(value == "0" or value == "1", "invalid Smart flag")
  return value == "1"
end
local function number(value, fallback, min, max)
  local n = tonumber(value or fallback)
  assert(n and n >= min and n <= max, "invalid Smart number")
  return n
end
assert(cfg.api_secret and #cfg.api_secret >= 24 and
  cfg.api_secret:match("^[%w_-]+$"),
  "API secret must contain at least 24 letters/numbers")
local listen_port = port(cfg.listen_port, 2088)
local controller_port = port(cfg.controller_port, 19090)
assert(listen_port ~= controller_port, "proxy and controller ports must differ")
local mode = bounded_text(cfg.mode, "sidecar", 16)
assert(mode == "sidecar" or mode == "global", "invalid Smart traffic mode")
local tun_interface = bounded_text(cfg.tun_interface, "smarttun", 15, "^[A-Za-z0-9_.-]+$")
local tun_address = bounded_text(cfg.tun_address, "172.19.0.1/30", 64, "^[0-9%.]+/[0-9]+$")
local probe_url = bounded_text(cfg.probe_url, "https://www.gstatic.com/generate_204", 512, "^https://[^%c%s]+$")
local expected_status = bounded_text(cfg.expected_status, "204", 32, "^[%d*/%-]+$")
local exclude_pattern = bounded_text(cfg.exclude_pattern, "", 512)
local policy_priority = bounded_text(cfg.policy_priority, "", 512)
local tolerance = number(cfg.tolerance, 0, 0, 65535)
local sample_rate = number(cfg.sample_rate, 0.25, 0.01, 1)
local providers, tags, seen, clients = {}, {}, {}, {{tag="fetch"}}
uci:foreach("smartbox", "provider", function(p)
  if p.enabled == "1" then
    local tag, url = p.name or "", p.url or ""
    assert(tag:match("^[%w_-]+$") and not seen[tag], "invalid or duplicate provider name")
    assert(url:match("^https://") and not url:find("[%c%s]"), "invalid HTTPS URL")
    local user_agent = p.user_agent or ""
    assert(#user_agent <= 200 and not user_agent:find("[%c]"), "invalid provider User-Agent")
    local interval = p.update_interval or "12h"
    assert(interval:match("^[1-9]%d*[hm]$"), "invalid refresh interval")
    local count, unit = interval:match("^(%d+)([hm])$")
    assert(count and (unit == "h" or tonumber(count) >= 60),
      "provider update interval must be at least 1 hour")
    seen[tag] = true
    local client_tag = "fetch"
    if user_agent ~= "" then
      client_tag = "fetch-" .. tag
      clients[#clients+1] = {
        tag=client_tag,
        headers={ ["User-Agent"] = user_agent }
      }
    end
    local provider = {type="remote", tag=tag, url=url,
      update_interval=interval, http_client=client_tag}
    providers[#providers+1] = provider
    tags[#tags+1] = tag
  end
end)
assert(#providers > 0 and #providers <= 50, "enable 1-50 providers")
local inbounds
local route = {final="auto", default_http_client="fetch"}
local obj = {
  log={level="info"},
  http_clients=clients,
  inbounds=nil,
  providers=providers,
  outbounds={{
    type="smart", tag="auto", providers=tags,
    url=probe_url, interval="5m",
    timeout="10s", expected_status=expected_status,
    prefer_asn=flag(cfg.prefer_asn, "0"), tolerance=tolerance,
    use_lightgbm=flag(cfg.use_lightgbm, "1"),
    collect_data=flag(cfg.collect_data, "1"), sample_rate=sample_rate
  },{type="direct", tag="direct"}},
  route=route,
  experimental={
    cache_file={enabled=true, path="/etc/sing-box-smart/cache.db"},
    clash_api={external_controller="127.0.0.1:" .. controller_port,secret=cfg.api_secret}
  }
}
if mode == "global" then
  inbounds = {{type="tun", tag="tun-in", interface_name=tun_interface,
    address={tun_address}, auto_route=true,
    auto_redirect=flag(cfg.tun_auto_redirect, "0"),
    strict_route=true, dns_mode="hijack"}}
  route.auto_detect_interface = true
  route.rules = {
    {inbound="tun-in", action="resolve", strategy="prefer_ipv4"},
    {inbound="tun-in", action="sniff"},
    {inbound="tun-in", protocol="dns", action="hijack-dns"}
  }
  obj.dns = {
    servers={{type="https", tag="smart-doh", server="1.1.1.1",
      server_port=443, path="/dns-query"}},
    final="smart-doh", strategy="prefer_ipv4"
  }
else
  inbounds = {{type="mixed", tag="local-test", listen="127.0.0.1",listen_port=listen_port}}
end
obj.inbounds = inbounds
if exclude_pattern ~= "" then obj.outbounds[1].exclude = exclude_pattern end
if policy_priority ~= "" then obj.outbounds[1].policy_priority = policy_priority end
local fp = assert(io.open(assert(os.getenv("CANDIDATE")), "w"))
assert(fp:write(assert(json.stringify(obj))))
assert(fp:close())
LUA
bin="$(uci -q get smartbox.main.binary || echo /usr/bin/sing-box-smart)"
case "$bin" in
  /*) ;;
  *) echo "Invalid Smart core path" >&2; exit 1 ;;
esac
[ -x "$bin" ] || { echo "Smart binary unavailable: $bin" >&2; exit 1; }
if "$bin" check -c "$CANDIDATE" >/dev/null; then
  mv "$CANDIDATE" /etc/sing-box-smart/config.json
  echo "Config validated"
else
  exit 1
fi
